# iOS APNs token authentication. Keep the .p8 private key out of Git.
# Base64 of the complete .p8 file; restore this external configuration separately.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=app.bananza.ios
APNS_PRIVATE_KEY_BASE64=
