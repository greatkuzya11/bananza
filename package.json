{
  "name": "bananza",
  "version": "1.0.0",
  "description": "🍌 BananZa — Self-hosted chat",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/run-node-tests.js",
    "test:all": "npm test && npm run test:e2e",
    "test:coverage": "c8 --config .c8rc.json node scripts/run-node-tests.js",
    "test:e2e": "playwright test",
    "vosk:install": "python -m pip install -r voice/requirements.txt",
    "vosk:start": "python voice/vosk_helper.py",
    "whisper:install": "node voice/whisperCli.js install",
    "whisper:start": "node voice/whisperCli.js start",
    "import:qip-emojis": "node scripts/import-qip-infium-original.js",
    "import:qip-hd-emojis": "node scripts/import-qip-hd-emojis.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "fast-xml-parser": "^5.8.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-client": "^2.18.9",
    "livekit-server-sdk": "^2.15.2",
    "luxon": "^3.5.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.34.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.8",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.41.9",
    "tar": "^7.5.15",
    "tar-stream": "^2.2.0",
    "uuid": "^10.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "y-prosemirror": "^1.3.7",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.31"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "c8": "^11.0.0",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0"
  }
}
